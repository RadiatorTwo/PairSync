<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PairSync.Desktop.ViewModels"
             x:Class="PairSync.Desktop.Views.PlaceholderView"
             x:DataType="vm:PlaceholderViewModel">
  <StackPanel Margin="{StaticResource PagePadding}" Spacing="18">
    <TextBlock Classes="h1" Text="{Binding Title}" />
    <Border Classes="banner" HorizontalAlignment="Left" MaxWidth="{StaticResource SettingsMaxWidth}"
            IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    </Border>
  </StackPanel>
</UserControl>
