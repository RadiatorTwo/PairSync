<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:PairSync.Desktop.Controls"
             xmlns:vm="using:PairSync.Desktop.ViewModels"
             xmlns:res="using:PairSync.Desktop.Resources"
             x:Class="PairSync.Desktop.Views.OverviewView"
             x:DataType="vm:OverviewViewModel">
  <UserControl.Styles>
    <!-- Entries below the first get a soft line and some air above. -->
    <Style Selector="ItemsControl.separated > ContentPresenter:nth-child(n+2)">
      <Setter Property="BorderBrush" Value="{StaticResource HairlineSoftBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="0,14,0,0" />
      <Setter Property="Margin" Value="0,14,0,0" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="{StaticResource PagePadding}" RowDefinitions="Auto,Auto,*" RowSpacing="18">
    <StackPanel Spacing="18">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="16" VerticalAlignment="Bottom">
          <TextBlock Classes="meta" VerticalAlignment="Center" Text="{Binding Header}" />
          <Button Name="PasteCode" Content="{x:Static res:Strings.Overview_PasteCode}" Command="{Binding PasteCodeCommand}"
                  IsVisible="{Binding CanPasteCode}" />
        </StackPanel>
        <TextBlock Classes="h1" Text="{Binding Title}" />
      </DockPanel>

      <!-- NAT failure: only after an ICE check failed without a relay -->
      <Border Name="NatBanner" Classes="banner warning" IsVisible="{Binding HasNatBanner}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center" Margin="16,0,0,0">
            <Button Classes="onDark" Content="{x:Static res:Strings.Nat_Run}" Command="{Binding RunDiagnosticCommand}" />
            <Button Classes="link onDark" FontSize="13" VerticalAlignment="Center" Content="{x:Static res:Strings.Nat_AboutRelays}"
                    Command="{Binding AboutRelaysCommand}" />
            <Button Classes="link onDark" FontSize="13" VerticalAlignment="Center" Content="{x:Static res:Strings.Banner_Dismiss}"
                    Command="{Binding DismissNatBannerCommand}" />
          </StackPanel>
          <TextBlock FontSize="14" TextWrapping="Wrap" LineHeight="20.3" VerticalAlignment="Center">
            <Run FontWeight="Bold" Text="{Binding NatBanner.Headline, FallbackValue=''}" />
            <Run Text="{Binding NatBanner.Detail, FallbackValue=''}" />
          </TextBlock>
        </DockPanel>
      </Border>
    </StackPanel>

    <!-- Device grid: 4 columns, 14 px apart -->
    <Panel Grid.Row="1">
      <TextBlock Classes="muted" Text="{x:Static res:Strings.Overview_NoDevices}" IsVisible="{Binding !HasDevices}" />
      <ItemsControl Name="DeviceGrid" ItemsSource="{Binding Devices}" Margin="0,0,-14,-14">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DeviceCardViewModel">
            <ctl:Card Margin="0,0,14,14"
                      Classes.connected="{Binding IsConnected}"
                      Classes.found="{Binding IsFound}"
                      Classes.offline="{Binding !IsConnected}">
              <StackPanel>
                <TextBlock Classes="mono" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,10,0,6"
                            IsVisible="{Binding State, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <Border Width="8" Height="8" VerticalAlignment="Center"
                          Background="{StaticResource AccentBrush}" IsVisible="{Binding IsConnected}" />
                  <Border Width="8" Height="8" VerticalAlignment="Center" BorderThickness="1"
                          BorderBrush="{StaticResource TextMutedBrush}" IsVisible="{Binding !IsConnected}" />
                  <TextBlock FontWeight="Medium" Text="{Binding State}" />
                </StackPanel>
                <TextBlock Classes="meta" LineHeight="19.5" TextWrapping="Wrap" Text="{Binding Line1}"
                           Margin="{Binding IsFound, Converter={x:Static vm:Converters.FoundTextMargin}}" />
                <TextBlock Classes="meta" LineHeight="19.5" TextTrimming="CharacterEllipsis" Text="{Binding Line2}"
                           IsVisible="{Binding Line2, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Classes="meta accent" LineHeight="19.5" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding InternetText}"
                           IsVisible="{Binding InternetText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Button Classes="accent" FontSize="13" Content="{x:Static res:Strings.Card_Pair}"
                        Command="{Binding PairCommand}" IsVisible="{Binding IsFound}" />
                <ItemsControl ItemsSource="{Binding Actions}" IsVisible="{Binding HasActions}" Margin="0,10,0,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel ItemSpacing="8" LineSpacing="6" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CardActionViewModel">
                      <Button FontSize="13" Classes.accent="{Binding IsPrimary}"
                              Content="{Binding Label}" Command="{Binding Command}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ctl:Card>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Panel>

    <Grid Grid.Row="2" ColumnDefinitions="1.4*,1*" ColumnSpacing="18">
      <Border Classes="panel">
        <DockPanel>
          <ctl:Rubric DockPanel.Dock="Top" Margin="0,0,0,16" Text="{x:Static res:Strings.Overview_Active}" />
          <TextBlock DockPanel.Dock="Top" Classes="muted" Text="{x:Static res:Strings.Overview_NoActive}"
                     IsVisible="{Binding !HasActiveTransfers}" />
          <ScrollViewer>
            <ItemsControl Name="ActiveTransfers" Classes="separated" ItemsSource="{Binding ActiveTransfers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TransferRowViewModel">
                  <StackPanel Spacing="8">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Classes="mono" VerticalAlignment="Center" Margin="12,0,0,0" Text="{Binding Size}" />
                      <TextBlock FontSize="15" TextTrimming="CharacterEllipsis">
                        <Run FontWeight="Bold" Text="{Binding Title}" />
                        <Run Text="{Binding Peer}" />
                      </TextBlock>
                    </DockPanel>
                    <ProgressBar Value="{Binding Fraction}" Classes.resumed="{Binding IsResumed}" />
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Classes="meta" Margin="12,0,0,0" Text="{Binding Rate}" />
                      <TextBlock Classes="meta" TextTrimming="CharacterEllipsis" Text="{Binding Meta}" />
                    </DockPanel>
                    <TextBlock Classes="meta" Text="{Binding ResumedText}"
                               IsVisible="{Binding ResumedText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="{x:Static res:Strings.Transfer_Pause}" Command="{Binding PauseCommand}" IsVisible="{Binding CanPause}" />
                      <Button Content="{x:Static res:Strings.Transfer_Resume}" Command="{Binding ResumeCommand}" IsVisible="{Binding CanResume}" />
                      <Button Classes="quiet" Content="{x:Static res:Strings.Transfer_Cancel}" Command="{Binding CancelCommand}" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Classes="panel">
        <DockPanel>
          <ctl:Rubric DockPanel.Dock="Top" Margin="0,0,0,16" Text="{x:Static res:Strings.Overview_Recent}" />
          <TextBlock DockPanel.Dock="Top" Classes="muted" Text="{x:Static res:Strings.Overview_NoRecent}"
                     IsVisible="{Binding !HasRecentTransfers}" />
          <ScrollViewer>
            <ItemsControl Name="RecentTransfers" ItemsSource="{Binding RecentTransfers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecentTransferViewModel">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,12">
                    <StackPanel>
                      <TextBlock FontWeight="Medium" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                      <TextBlock Classes="meta" TextTrimming="CharacterEllipsis" Text="{Binding Details}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                      <TextBlock Classes="meta" HorizontalAlignment="Right" Text="{Binding When}" />
                      <TextBlock HorizontalAlignment="Right" FontSize="13" Text="{Binding Outcome}"
                                 Classes.problem="{Binding IsProblem}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
