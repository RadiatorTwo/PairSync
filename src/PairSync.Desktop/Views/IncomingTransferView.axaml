<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:PairSync.Desktop.Controls"
             xmlns:vm="using:PairSync.Desktop.ViewModels"
             xmlns:res="using:PairSync.Desktop.Resources"
             x:Class="PairSync.Desktop.Views.IncomingTransferView"
             x:DataType="vm:IncomingTransferViewModel">
  <StackPanel Spacing="16">
    <StackPanel Spacing="6">
      <ctl:Rubric Text="{x:Static res:Strings.Incoming_Rubric}" />
      <TextBlock Classes="h2" TextWrapping="Wrap" Text="{Binding Title}" />
      <TextBlock Classes="meta" Text="{Binding Summary}" />
    </StackPanel>

    <StackPanel Spacing="4">
      <ItemsControl ItemsSource="{Binding Entries}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Classes="mono" TextTrimming="CharacterEllipsis" Text="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="meta" Text="{Binding More}" IsVisible="{Binding More, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <StackPanel Spacing="8">
      <ctl:Rubric Text="{x:Static res:Strings.Incoming_Target}" />
      <DockPanel>
        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{x:Static res:Strings.Incoming_Change}" Command="{Binding ChangeFolderCommand}" />
        <Border Classes="input">
          <TextBlock Classes="mono" TextTrimming="PrefixCharacterEllipsis" Text="{Binding TargetFolder}" ToolTip.Tip="{Binding TargetFolder}" />
        </Border>
      </DockPanel>
      <TextBlock Classes="problem" FontSize="13" Text="{Binding SpaceWarning}"
                 IsVisible="{Binding SpaceWarning, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <StackPanel Spacing="8">
      <ctl:Rubric Text="{x:Static res:Strings.Send_Existing}" />
      <RadioButton Content="{x:Static res:Strings.Policy_KeepBoth}" IsChecked="{Binding IsKeepBoth}" />
      <RadioButton Content="{x:Static res:Strings.Policy_Replace}" IsChecked="{Binding IsReplace}" />
      <RadioButton Content="{x:Static res:Strings.Policy_Skip}" IsChecked="{Binding IsSkip}" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
      <Button Name="Decline" Content="{x:Static res:Strings.Incoming_Decline}" Command="{Binding DeclineCommand}" />
      <Button Name="Accept" Classes="primary compact" Content="{x:Static res:Strings.Incoming_Accept}" Command="{Binding AcceptCommand}" />
    </StackPanel>
  </StackPanel>
</UserControl>
