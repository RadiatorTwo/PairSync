<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PairSync.Desktop.ViewModels"
             xmlns:res="using:PairSync.Desktop.Resources"
             x:Class="PairSync.Desktop.Views.IdentityPasswordDialogView"
             x:DataType="vm:IdentityPasswordDialogViewModel">
  <StackPanel Spacing="12" MaxWidth="420">
    <TextBlock Classes="h2" TextWrapping="Wrap" Text="{Binding Title}" />
    <TextBlock Text="{x:Static res:Strings.Identity_Password}" />
    <TextBox Name="PasswordInput" PasswordChar="•" Text="{Binding Password}" />
    <StackPanel Spacing="12" IsVisible="{Binding IsExport}">
      <TextBlock Text="{x:Static res:Strings.Identity_Repeat}" />
      <TextBox Name="RepeatInput" PasswordChar="•" Text="{Binding Repeat}" />
      <TextBlock Classes="hint" TextWrapping="Wrap" Text="{x:Static res:Strings.Identity_PasswordHint}" />
    </StackPanel>
    <TextBlock Classes="problem" FontSize="13" TextWrapping="Wrap" Text="{Binding Error}"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
      <Button Content="{x:Static res:Strings.Dialog_Cancel}" Command="{Binding CancelCommand}" />
      <Button Classes="primary compact" IsDefault="True" Content="{x:Static res:Strings.Identity_Continue}" Command="{Binding ConfirmCommand}" />
    </StackPanel>
  </StackPanel>
</UserControl>
