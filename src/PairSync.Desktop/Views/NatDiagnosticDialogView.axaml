<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PairSync.Desktop.ViewModels"
             xmlns:res="using:PairSync.Desktop.Resources"
             x:Class="PairSync.Desktop.Views.NatDiagnosticDialogView"
             x:DataType="vm:NatDiagnosticDialogViewModel">
  <StackPanel Spacing="16">
    <TextBlock Classes="h2" Text="{x:Static res:Strings.Nat_Title}" />
    <TextBlock Classes="hint" TextWrapping="Wrap" Text="{x:Static res:Strings.Nat_Intro}" />
    <TextBlock Classes="muted" Text="{x:Static res:Strings.Nat_Running}" IsVisible="{Binding IsRunning}" />

    <ItemsControl Name="Rows" ItemsSource="{Binding Rows}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:DiagnosticRow">
          <Grid ColumnDefinitions="220,*" ColumnSpacing="14" Margin="0,0,0,8">
            <TextBlock Classes="meta" TextTrimming="CharacterEllipsis" Text="{Binding Check}" />
            <TextBlock Grid.Column="1" FontSize="13" TextWrapping="Wrap" Text="{Binding Result}" Classes.problem="{Binding IsProblem}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border Classes="banner" IsVisible="{Binding Summary, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Name="Summary" TextWrapping="Wrap" FontWeight="Medium" Text="{Binding Summary}" />
    </Border>

    <CheckBox IsChecked="{Binding IncludePublicAddress}" IsVisible="{Binding PublicAddress, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.Nat_IncludeAddress}" />
    </CheckBox>

    <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10">
        <Button Content="{x:Static res:Strings.Nat_CopyReport}" Command="{Binding CopyReportCommand}" IsEnabled="{Binding IsDone}" />
        <Button Classes="primary compact" Content="{x:Static res:Strings.Dialog_Done}" Command="{Binding DoneCommand}" />
      </StackPanel>
      <TextBlock Classes="meta" VerticalAlignment="Center" Text="{Binding CopiedText}" />
    </DockPanel>
  </StackPanel>
</UserControl>
