<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PairSync.Desktop.ViewModels"
             xmlns:res="using:PairSync.Desktop.Resources"
             x:Class="PairSync.Desktop.Views.ClaudeDiffDialogView"
             x:DataType="vm:ClaudeDiffDialogViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Classes="h2" TextWrapping="Wrap" Margin="0,0,0,16" Text="{Binding Title}" />
    <Button DockPanel.Dock="Bottom" Classes="primary compact" HorizontalAlignment="Right" Margin="0,16,0,0"
            Content="{x:Static res:Strings.Dialog_Done}" Command="{Binding DoneCommand}" />
    <ScrollViewer MaxHeight="420">
      <ItemsControl ItemsSource="{Binding Lines}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Classes="mono" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" Text="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
