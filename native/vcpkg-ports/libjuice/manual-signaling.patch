diff --git a/src/agent.h b/src/agent.h
--- a/src/agent.h
+++ b/src/agent.h
@@ -25,7 +25,12 @@
 // RFC 8445: Agents MUST NOT use an RTO value smaller than 500 ms.
 #define MIN_STUN_RETRANSMISSION_TIMEOUT 500 // msecs
 #define LAST_STUN_RETRANSMISSION_TIMEOUT (MIN_STUN_RETRANSMISSION_TIMEOUT * 16)
-#define MAX_STUN_CHECK_RETRANSMISSION_COUNT 6  // exponential backoff, total 39500ms
+// PairSync: codes are exchanged by hand, so the answering side may wait minutes until the offering
+// side applies the answer. Its checks must keep going meanwhile, or NAT/firewall state towards the
+// other side expires and the late checks from there are dropped. Backoff is capped at 5 s, and
+// 125 retransmissions cover about 10 minutes (0.5+1+2+4 s, then 121 x 5 s), matching ICE_PAC_TIMEOUT.
+#define MAX_STUN_CHECK_RETRANSMISSION_COUNT 125
+#define MAX_STUN_CHECK_RETRANSMISSION_TIMEOUT 5000 // msecs
 #define MAX_STUN_SERVER_RETRANSMISSION_COUNT 5 // total 23500ms
 #define STUN_TCP_TIMEOUT LAST_STUN_RETRANSMISSION_TIMEOUT
 
@@ -40,7 +45,10 @@
 // ICE Patiently Awaiting Connectivity timer
 // RFC 8863: The RECOMMENDED duration for the PAC timer is equal to the agent's connectivity check
 // transaction timeout, including all retransmissions.
-#define ICE_PAC_TIMEOUT 39500 // msecs
+// PairSync: the answering side waits for the manually exchanged answer to be applied on the other
+// side (see MAX_STUN_CHECK_RETRANSMISSION_COUNT); PairSync enforces its own, shorter deadlines where
+// it can tell that both sides are ready.
+#define ICE_PAC_TIMEOUT 600000 // msecs
 
 // Consent freshness
 // RFC 7675: Consent expires after 30 seconds.
